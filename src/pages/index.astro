---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts=(await getCollection('blog', ({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---
<Base><section class="hero"><div class="wrap"><div class="eyebrow">Water with a greater purpose</div><h1>Conservation<br/>with every sip.</h1><p>At Watercana, our vision is to provide natural spring water while helping safeguard the springs, forests and communities that make clean water possible.</p><a class="btn" href="/our-water/">Explore our water</a><a class="btn alt" href="/conservation/">Our conservation work</a></div></section>
<section class="section"><div class="wrap split"><div><div class="eyebrow">More than bottled water</div><h2>A water company rooted in conservation.</h2><p class="lead">Watercana brings together a commercial water business and a long-term commitment to protect natural springs and their surrounding ecosystems.</p><p>Our model commits 20% of net profits to spring conservation and community environmental education.</p><a class="btn dark" href="/our-story/">Read our story</a></div><div class="visual" aria-label="Illustration of a water droplet">💧</div></div></section>
<section class="section soft"><div class="wrap"><div class="eyebrow">Our focus</div><h2>Pure purpose. Lasting impact.</h2><div class="grid"><div class="card"><div class="visual">💦</div><h3>Natural spring water</h3><p>Discover our approach to water sourcing, responsible handling and quality.</p><a href="/our-water/">Learn more →</a></div><div class="card"><div class="visual">🌳</div><h3>Protecting ecosystems</h3><p>Supporting spring protection, indigenous tree planting and responsible stewardship.</p><a href="/conservation/">Explore conservation →</a></div><div class="card"><div class="visual">🤝</div><h3>Community partnership</h3><p>Building awareness of the role healthy landscapes play in securing water for the future.</p><a href="/our-story/">Our mission →</a></div></div></div></section>
<section class="section"><div class="wrap"><div class="eyebrow">From the journal</div><h2>Stories from the source</h2><p class="lead">Follow our progress, lessons and conservation activities.</p><div class="grid">{posts.map(post=><a class="card blog-card" href={`/journal/${post.id}/`}>{post.data.image ? <img src={post.data.image} alt=""/> : <div class="visual">🌿</div>}<p class="meta">{post.data.date.toLocaleDateString('en-KE',{day:'numeric',month:'long',year:'numeric'})} · {post.data.category}</p><h3>{post.data.title}</h3><p>{post.data.description}</p></a>)}</div><p><a class="btn dark" href="/journal/">Visit our journal</a></p></div></section><section class="cta"><div class="wrap"><div class="eyebrow">Join the journey</div><h2>Water for today. Conservation for tomorrow.</h2><p>Interested in our water, institutional supply or environmental partnerships?</p><a class="btn" href="/contact/">Get in touch</a></div></section></Base>
