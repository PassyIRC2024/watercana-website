
---
import Base from '../layouts/Base.astro';
---

<Base>
  <!-- HERO -->
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow">
        Our Conservation Commitment
      </div>

      <h1>
        Protect the source.<br />
        Sustain the future.
      </h1>

      <p>
        At Watercana, conservation is not a separate
        corporate responsibility initiative. It is
        built into the foundation of our business.
        We are developing a model where responsible
        water production helps finance the long-term
        protection of natural freshwater springs.
      </p>

      <div class="hero-actions">
        <a class="btn" href="#our-model">
          Explore our model
        </a>
        <a class="btn alt" href="/contact/">
          Partner with us
        </a>
      </div>
    </div>
  </section>

  <!-- WHY CONSERVATION MATTERS -->
  <section class="section">
    <div class="wrap split">
      <div>
        <div class="eyebrow">
          Why we protect springs
        </div>

        <h2>
          Healthy springs depend on healthy surroundings.
        </h2>

        <p class="lead">
          Protecting freshwater means protecting the
          land and natural systems that sustain it.
        </p>

        <p>
          Human activity, land disturbance and
          environmental degradation can threaten
          freshwater sources over time.
        </p>

        <p>
          Watercana's approach begins with protecting
          land adjacent to natural springs, limiting
          disruptive activities and supporting
          indigenous reforestation.
        </p>

        <p>
          Our goal is to help safeguard these sources
          for the communities and generations that
          depend on them.
        </p>
      </div>

      <div class="card">
        <div class="eyebrow">
          Our belief
        </div>

        <h2>
          Conservation begins before the first bottle.
        </h2>

        <p>
          We began with land protection and environmental
          stewardship before launching commercial
          water production.
        </p>
      </div>
    </div>
  </section>

  <!-- FOUR STAGE MODEL -->
  <section class="section soft" id="our-model">
    <div class="wrap">
      <div class="eyebrow">
        The Watercana Model
      </div>

      <h2>
        A practical approach to lasting conservation.
      </h2>

      <p class="lead">
        Our model connects environmental protection
        with the commercial activity needed to
        sustain it over time.
      </p>

      <div class="conservation-grid">
        <div class="card">
          <div class="step-number">01</div>
          <h3>Secure the source</h3>
          <p>
            Acquire or lease land adjacent to natural
            springs to support long-term protection
            and reduce disruptive human activity
            around the water source.
          </p>
        </div>

        <div class="card">
          <div class="step-number">02</div>
          <h3>Restore and protect</h3>
          <p>
            Support indigenous reforestation,
            responsible land stewardship and
            protection of the surrounding
            spring recharge environment.
          </p>
        </div>

        <div class="card">
          <div class="step-number">03</div>
          <h3>Build responsible production</h3>
          <p>
            Establish an appropriate water-treatment
            and bottling facility at the source,
            supported by water-quality verification
            and applicable regulatory compliance.
          </p>
        </div>

        <div class="card">
          <div class="step-number">04</div>
          <h3>Reinvest in conservation</h3>
          <p>
            Commit 20% of future net profits to
            spring protection, indigenous
            reforestation and community
            environmental awareness.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CONSERVATION IMAGE -->
  <section class="section">
    <div class="wrap">
      <div class="eyebrow">
        Our approach in action
      </div>

      <h2>
        Commerce supporting conservation.
      </h2>

      <p class="lead">
        A closed-loop model designed to create
        a lasting source of funding for
        environmental protection.
      </p>

      <div class="model-image">
        <img
          src="/images/watercana-conservation-model.png"
          alt="Illustration of Watercana's model connecting spring protection, reforestation, responsible water production and conservation reinvestment"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- PROFIT COMMITMENT -->
  <section class="section soft">
    <div class="wrap split">
      <div>
        <div class="eyebrow">
          Our Conservation Promise
        </div>

        <h2>
          A commitment designed into the business.
        </h2>

        <p class="lead">
          We commit 20% of net profits to
          conservation once commercial
          operations become profitable.
        </p>

        <p>
          The commitment is intended to support
          the protection of natural springs,
          indigenous tree planting and
          environmental awareness within
          surrounding communities.
        </p>

        <p>
          As Watercana develops, we aim to
          communicate our conservation activities
          and progress transparently.
        </p>
      </div>

      <div class="card commitment-card">
        <div class="eyebrow">
          Our long-term commitment
        </div>

        <div class="commitment-number">
          20%
        </div>

        <h3>Of future net profits</h3>

        <p>
          Committed to spring conservation
          and community environmental
          awareness once profitable.
        </p>

        <strong>
          Conservation with every sip.
        </strong>
      </div>
    </div>
  </section>

  <!-- CURRENT PROGRESS -->
  <section class="section">
    <div class="wrap">
      <div class="eyebrow">
        Our progress
      </div>

      <h2>
        Starting with our first spring.
      </h2>

      <p class="lead">
        Watercana's conservation journey
        has already begun in Belgut, Kenya.
      </p>

      <div class="grid">
        <div class="card">
          <h3>Land acquired</h3>
          <p>
            Land adjacent to our first natural
            spring has been acquired as a
            foundation for source protection.
          </p>
        </div>

        <div class="card">
          <h3>Conservation underway</h3>
          <p>
            Our activities include limiting
            disruptive human activity and
            supporting indigenous reforestation
            around the spring.
          </p>
        </div>

        <div class="card">
          <h3>Preparing for production</h3>
          <p>
            We are working toward establishing
            the treatment and bottling facility,
            with further water-quality testing
            and verification required before launch.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- LONG TERM VISION -->
  <section class="section soft">
    <div class="wrap">
      <div class="eyebrow">
        Looking ahead
      </div>

      <h2>
        One protected spring can be the beginning
        of something bigger.
      </h2>

      <p class="lead">
        Our long-term ambition is to extend
        this model to additional natural
        freshwater springs.
      </p>

      <p>
        Through responsible land acquisition
        or long-term leases, environmental
        stewardship and carefully planned
        commercial water production, we aim
        to create a replicable approach to
        protecting freshwater sources.
      </p>

      <p>
        We envision a future in which
        successful water enterprises contribute
        directly to the protection of the
        environments that sustain them.
      </p>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="cta">
    <div class="wrap">
      <div class="eyebrow">
        Join our conservation journey
      </div>

      <h2>
        Let's protect the sources
        that sustain us.
      </h2>

      <p>
        We welcome partnerships with
        conservation organisations,
        environmental specialists,
        institutions and investors
        who share our vision.
      </p>

      <a class="btn" href="/contact/">
        Partner with Watercana
      </a>
    </div>
  </section>
</Base>

<style>
  .conservation-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .step-number {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
    color: #087f91;
    margin-bottom: 1.25rem;
  }

  .conservation-grid .card {
    padding: 2rem;
  }

  .conservation-grid .card p,
  .section .card p {
    line-height: 1.7;
  }

  .model-image {
    max-width: 1100px;
    margin: 2rem auto 0;
  }

  .model-image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 22px;
  }

  .commitment-card {
    padding: 2.5rem;
  }

  .commitment-number {
    font-size: clamp(5rem, 10vw, 8rem);
    font-weight: 800;
    line-height: 1;
    color: #087f91;
    margin: 1rem 0;
  }

  .commitment-card h3 {
    margin-bottom: 1rem;
  }

  .commitment-card strong {
    display: block;
    margin-top: 1.5rem;
  }

  .section .wrap > p {
    max-width: 900px;
  }

  @media (max-width: 760px) {
    .conservation-grid {
      grid-template-columns: 1fr;
    }

    .conservation-grid .card,
    .commitment-card {
      padding: 1.5rem;
    }

    .model-image img {
      border-radius: 14px;
    }
  }
</style>
